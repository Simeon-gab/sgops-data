# SgOps Data — Environment Variables
# Copy this file to .env.local and fill in your values
# All variables marked NEXT_PUBLIC_* are exposed to the browser

# ━━━ Supabase ━━━
# Get from: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server only, never expose to browser
# Required for webhooks and background jobs that run without a user session
SUPABASE_SERVICE_ROLE_KEY=

# ━━━ Anthropic (Claude API) ━━━
# Get from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ━━━ Google Places API ━━━
# Get from: https://console.cloud.google.com/apis/credentials
# Enable: Places API (New)
# Without this key the app runs in demo mode with mock data
GOOGLE_PLACES_API_KEY=

# ━━━ SerpAPI (fallback extraction) ━━━
# Get from: https://serpapi.com/
SERPAPI_KEY=

# ━━━ Hunter.io (email verification) ━━━
# Get from: https://hunter.io/api-keys
HUNTER_API_KEY=

# ━━━ Resend (email sending) ━━━
# Get from: https://resend.com/api-keys
RESEND_API_KEY=
# The "from" address used for outreach emails
# Must be a verified domain in your Resend account
# Falls back to onboarding@resend.dev if not set (Resend sandbox, limited recipients)
RESEND_FROM_EMAIL=

# ━━━ Resend Webhooks (required for delivery tracking and bounce handling) ━━━
# Configure at: https://resend.com/webhooks
# Webhook URL: https://<your-domain>/api/webhooks
# Required events: email.sent, email.delivered, email.opened, email.clicked,
#                  email.bounced, email.delivery_delayed, email.complained
# Every request is signature-verified against this secret. Without it the
# endpoint refuses everything: it is public and it writes to the suppression
# list, so an unverified caller could suppress a workspace's contacts or
# falsify delivery status. Delivery tracking not working is the lesser problem.
RESEND_WEBHOOK_SECRET=

# ━━━ Campaign cron (required for unattended sending) ━━━
# Vercel Cron calls /api/cron/campaigns with "Authorization: Bearer <this>".
# Without it that route refuses every request, and campaigns only progress
# while someone has the campaign page open.
# Generate one with: openssl rand -hex 32
# vercel.json schedules this once a day, which is what the Hobby plan allows:
# a more frequent expression is rejected at deploy time and fails the build.
# Once a day is too slow to actually drive a campaign, so either
#   - upgrade the plan and change the schedule to "* * * * *", or
#   - point an external scheduler (cron-job.org, GitHub Actions, an uptime
#     pinger) at https://<your-domain>/api/cron/campaigns every minute,
#     sending "Authorization: Bearer <CRON_SECRET>".
# Without one of those, a campaign only progresses while its page is open.
CRON_SECRET=

# ━━━ Sending credentials encryption ━━━
# Encrypts sending credentials with AES-256-GCM before they are written to the
# database, so a backup or a leaked connection string yields ciphertext rather
# than a working mailbox password.
# Required as soon as anyone adds a mail server of their own (SMTP identities).
# Identities that send through the platform's Resend account carry no secrets
# and do not need this set.
# Generate with: openssl rand -hex 32
# Losing or rotating this makes every stored credential unreadable, and each
# affected workspace has to re-enter theirs.
SENDING_SECRET_KEY=

# ━━━ Private SMTP hosts (development and self-hosting only) ━━━
# By default an SMTP identity may not point at localhost or a private network
# range: on a multi-tenant deployment the host comes from whoever signed up,
# and arbitrary hosts turn the sender into a way to reach internal services.
# Set to true only when the mail server genuinely is on the same private
# network, or when running locally.
SMTP_ALLOW_PRIVATE_HOSTS=
